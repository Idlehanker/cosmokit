{
  "compilerOptions": {
    "rootDir": "src",
    "outFile": "lib/index.d.ts",
    "target": "es2023",
    "module": "commonjs",
    "strict": true,
    "sourceMap": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "cosmokit": [
        "src"
      ],
      "cosmokit/*": [
        "src/*"
      ],
    },
  },
  "include": [
    "src",
  ],
}